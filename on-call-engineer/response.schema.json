{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockroom.local/on-call-engineer/response.schema.json",
  "title": "Stockroom incident response",
  "description": "The responder's record for one incident. Every object is closed: a field that is not declared here is a validation failure, not a silent extra. The Markdown record in incidents/<id>.md is rendered from a document that passed this schema, so the two cannot disagree.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "incident_id",
    "alert",
    "user_impact",
    "evidence_inspected",
    "hypothesis",
    "action",
    "changes",
    "policy",
    "verification",
    "timing",
    "detection_gap",
    "escalation",
    "review"
  ],
  "properties": {
    "incident_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*-[0-9a-f]{12}-[0-9]+$"
    },
    "alert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "severity",
        "environment",
        "version",
        "dashboard_url",
        "rule"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "severity": { "type": ["string", "null"] },
        "environment": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] },
        "dashboard_url": { "type": ["string", "null"], "format": "uri" },
        "rule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expr", "for"],
          "properties": {
            "expr": { "type": ["string", "null"] },
            "for": { "type": ["string", "null"] }
          }
        }
      }
    },
    "user_impact": { "type": "string", "minLength": 1 },
    "evidence_inspected": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "hypothesis": { "type": "string", "minLength": 1 },
    "action": { "enum": ["fix", "no_action", "escalate"] },
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "test", "branch", "base_ref", "worktree", "pr_url"],
      "properties": {
        "files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "test": { "type": ["string", "null"] },
        "branch": { "type": ["string", "null"] },
        "base_ref": { "type": ["string", "null"] },
        "worktree": { "type": ["string", "null"] },
        "pr_url": { "type": ["string", "null"] }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256", "decisions"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "decision", "rule_id", "reason"],
            "properties": {
              "action": { "type": "string", "minLength": 1 },
              "decision": { "enum": ["allow", "deny", "escalate"] },
              "rule_id": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks", "observed_at"],
      "properties": {
        "status": { "enum": ["verified", "failed", "not_run"] },
        "checks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started", "ended", "elapsed_seconds", "budget_seconds"],
      "properties": {
        "started": { "type": "string", "format": "date-time" },
        "ended": { "type": "string", "format": "date-time" },
        "elapsed_seconds": { "type": "number", "minimum": 0 },
        "budget_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "detection_gap": { "type": "string" },
    "escalation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision_required"],
          "properties": {
            "decision_required": { "type": "string", "minLength": 1 },
            "context": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "notes"],
      "properties": {
        "status": { "enum": ["pending", "not_required"] },
        "notes": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "action": { "const": "fix" } },
        "required": ["action"]
      },
      "then": {
        "properties": {
          "changes": {
            "properties": {
              "files": { "minItems": 1 },
              "test": { "type": "string", "minLength": 1 },
              "branch": { "type": "string", "minLength": 1 },
              "base_ref": { "type": "string", "minLength": 1 },
              "worktree": { "type": "string", "minLength": 1 },
              "pr_url": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "action": { "const": "escalate" } },
        "required": ["action"]
      },
      "then": {
        "properties": {
          "escalation": {
            "required": ["decision_required"],
            "properties": {
              "decision_required": { "minLength": 1 }
            }
          },
          "changes": {
            "properties": { "pr_url": { "type": "null" } }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "action": { "enum": ["fix", "no_action"] } },
        "required": ["action"]
      },
      "then": {
        "properties": {
          "escalation": { "type": "null" }
        }
      }
    }
  ]
}
