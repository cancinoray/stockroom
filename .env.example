# Copy to .env for local runs. Every value is optional; these are the defaults.
STOCKROOM_ENVIRONMENT=development
STOCKROOM_OPERATOR_NAME=demo-operator
STOCKROOM_COMMIT=unknown
STOCKROOM_BUILD_TIME=unknown

# On-call alert poller (T7.1, #61). Local-only, read-only, no credentials.
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
STOCKROOM_APP_URL=http://localhost:8000
ONCALL_POLL_INTERVAL_SECONDS=60
ONCALL_LOOKBACK_MINUTES=15
ONCALL_LOG_SAMPLES=20
ONCALL_TRACE_SAMPLES=3
ONCALL_HTTP_TIMEOUT_SECONDS=5
ONCALL_EVIDENCE_DIR=on-call-engineer/evidence
ONCALL_STATE_DIR=on-call-engineer/.state
ONCALL_RESOLVE_GRACE_POLLS=2
ONCALL_BASE_REF=main
# Empty means `git rev-parse HEAD` at poll time.
ONCALL_BASE_COMMIT=
# The image the local stack runs (compose.yaml's STOCKROOM_IMAGE default).
STOCKROOM_IMAGE=stockroom-app:local
